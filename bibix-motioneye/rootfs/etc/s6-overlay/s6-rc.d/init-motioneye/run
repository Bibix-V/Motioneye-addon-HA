#!/bin/bash
# =============================================================================
# Home Assistant Community Add-on: motionEye
# Creates initial motionEye configuration in case it is non-existing
# =============================================================================

set -e

readonly CONF='/data/motioneye/motioneye.conf'
readonly MOTION='/data/motioneye/motion.conf'

# Ensure configuration exists
if [ ! -d '/data/motioneye' ] || [ ! -f '/data/motioneye/motioneye.conf' ]; then
    mkdir -p /data/motioneye
    cp -R /etc/motioneye/* /data/motioneye/
fi

# Migration
if [ -f "${CONF}" ]; then
    echo "Running startup migrations"

    # Migration désactivée temporairement :
    # /usr/lib/python3.13/site-packages/motioneye/scripts/migrateconf.sh "${CONF}"

    # find /data/motioneye/ \
    #     -maxdepth 1 \
    #     -type f \
    #     -name "thread-*.conf" \
    #     -exec \
    #         /usr/lib/python3.13/site-packages/motioneye/scripts/migrateconf.sh {} \;
fi

# Configure motion webcontrol access based on config.json
MOTION_WEBCONTROL="false"
if [ -f "/data/options.json" ]; then
    MOTIONEYE_MOTION_WEBCONTROL=$(jq -r '.motion_webcontrol // false' /data/options.json 2>/dev/null || echo "false")
    if [ "${MOTIONEYE_MOTION_WEBCONTROL}" = "true" ]; then
        MOTION_WEBCONTROL="true"
    fi
fi

if [ "${MOTION_WEBCONTROL}" = "true" ]; then
    echo "Enabling motion webcontrol..."
    sed -i "s/webcontrol_localhost on/webcontrol_localhost off/" "$MOTION"
else
    sed -i "s/webcontrol_localhost off/webcontrol_localhost on/" "$MOTION"
fi

# Creates initial motionEye media folder in case it is non-existing
if [ ! -d '/share/motioneye' ]; then
    mkdir -p /share/motioneye
fi

# Remove any existing action buttons before recreating
for old_action in lock unlock light_on light_off alarm_on alarm_off up right \
    down left zoom_in zoom_out preset1 preset2 preset3 preset4 preset5 preset6 \
    preset7 preset8 preset9; do
    find /data/motioneye/. -name "${old_action}_*" -delete 2>/dev/null || true
done

# Creates action button scripts if any are configured
if [ -f "/data/options.json" ]; then
    ACTION_BUTTONS_JSON=$(jq -r '.action_buttons // empty' /data/options.json 2>/dev/null || echo "")
    if [ -n "${ACTION_BUTTONS_JSON}" ]; then
        echo "Configuring action buttons."
        for button_key in $(echo "${ACTION_BUTTONS_JSON}" | jq -r 'keys[]' 2>/dev/null); do
            button_type=$(echo "${ACTION_BUTTONS_JSON}" | jq -r ".${button_key}.type" 2>/dev/null)
            camera_number=$(echo "${ACTION_BUTTONS_JSON}" | jq -r ".${button_key}.camera" 2>/dev/null)
            button_command=$(echo "${ACTION_BUTTONS_JSON}" | jq -r ".${button_key}.command" 2>/dev/null)
            if [ -n "${button_type}" ] && [ -n "${button_command}" ]; then
                {
                    echo "#!/usr/bin/env bash"
                    echo "${button_command}"
                } > "/data/motioneye/${button_type}_${camera_number}"
                chmod +x "/data/motioneye/${button_type}_${camera_number}"
            fi
        done
    fi
fi

# =============================================================================
# DEBUG - Inspect generated Motion camera hooks
# =============================================================================

echo "=== DEBUG MOTIONEYE CAMERA CONFIG ==="

for f in /data/motioneye/camera-*.conf; do
    if [ -f "$f" ]; then
        echo "--- $f ---"

        grep -E \
'on_event_start|on_event_end|on_movie_end|on_picture_save|target_dir|movie_output|picture_output|event_gap|emulate_motion' \
        "$f" || true
    fi
done

echo "=== END DEBUG MOTIONEYE CAMERA CONFIG ==="

# =============================================================================
# Workaround motionEye 0.44 - on_event_start
# =============================================================================

echo "Applying motionEye event wrapper workaround..."

for f in /data/motioneye/camera-*.conf; do
    if [ -f "$f" ]; then
        sed -i \
            's#^on_event_start .*#on_event_start /usr/local/bin/motioneye-event-wrapper start %t#' \
            "$f"
    fi
done

echo "motionEye event wrapper workaround applied."

# =============================================================================
# DEBUG - Vérification finale du hook on_event_start
# =============================================================================

echo "=== DEBUG FINAL on_event_start ==="

grep -H '^on_event_start' /data/motioneye/camera-*.conf || true

echo "=== END DEBUG FINAL on_event_start ==="

echo "=== PREVIOUS EVENT WRAPPER DEBUG ==="

if [ -f /data/motioneye/event-wrapper-debug.log ]; then
    tail -n 100 /data/motioneye/event-wrapper-debug.log
else
    echo "No event-wrapper-debug.log found"
fi

echo "=== END PREVIOUS EVENT WRAPPER DEBUG ==="

echo "=== PREVIOUS RUNTIME CAMERA DEBUG ==="

if [ -f /data/motioneye/runtime-camera-debug.log ]; then
    cat /data/motioneye/runtime-camera-debug.log
else
    echo "No runtime-camera-debug.log found"
fi

echo "=== END PREVIOUS RUNTIME CAMERA DEBUG ==="

# =============================================================================
# DEBUG - Vérification différée après démarrage de motionEye
# =============================================================================

(
    sleep 15

    {
        echo "=== DEBUG RUNTIME CAMERA CONFIG ==="
        date

        for f in /data/motioneye/camera-*.conf; do
            if [ -f "$f" ]; then
                echo "--- $f ---"
                grep -H '^on_event_start' "$f" || true
            fi
        done

        echo "=== END DEBUG RUNTIME CAMERA CONFIG ==="
    } > /data/motioneye/runtime-camera-debug.log 2>&1
) &
